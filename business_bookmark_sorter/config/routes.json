{
  "review": {
    "auto_export_on_mark": true,
    "open_docx_on_mark": true
  },
  "export": {
    "master_links_file": "business_bookmark_sorter/Business Links.md"
  },
  "export_section_order": [
    "started",
    "prospects",
    "formulated",
    "formulation_strategy",
    "problem_identification",
    "leads",
    "automation",
    "other"
  ],
  "chrome_filter": {
    "folder_name_contains": ["business"],
    "match_url_or_title": true
  },
  "destinations": {
    "started": {
      "label": "Business started",
      "folder": "Started-Businesses"
    },
    "prospects": {
      "label": "Prospect businesses",
      "folder": "Prospect-Businesses"
    },
    "formulated": {
      "label": "Formulated ideas",
      "folder": "business_research"
    },
    "formulation_strategy": {
      "label": "Idea formulation (strategy folder)",
      "folder": "Business-Idea-Formulation-Strategy-5-News-Based-Problem-Extraction"
    },
    "problem_identification": {
      "label": "Problem identification",
      "folder": "problem_identification_tool"
    },
    "leads": {
      "label": "My leads",
      "folder": "abuja_lead_generator"
    },
    "automation": {
      "label": "Automation / content",
      "folder": "Strategy-2-Problem-Solving/Content-Automation"
    },
    "other": {
      "label": "Other",
      "folder": "business_bookmark_sorter",
      "assignable": true
    },
    "inbox": {
      "label": "Staging inbox (legacy)",
      "folder": "business_bookmark_sorter",
      "assignable": false
    },
    "stay_in_chrome": {
      "label": "Stay in Chrome",
      "folder": null,
      "assignable": false
    }
  },
  "keyword_rules": [
    { "destination": "leads", "keywords": ["lead", "abuja", "outreach"] },
    { "destination": "problem_identification", "keywords": ["problem", "questionnaire", "problem_finder"] },
    { "destination": "automation", "keywords": ["youtube", "content-automation", "netlify"] },
    { "destination": "formulation_strategy", "keywords": ["formulation", "strategy-", "news_problems", "business-idea"] },
    { "destination": "prospects", "keywords": ["prospect-business", "prospect_businesses", "examfee-planner", "agentdispute", "scimlite"] },
    { "destination": "formulated", "keywords": ["business_ideas", "past_business", "business_research", "crunchbase"] },
    { "destination": "started", "keywords": ["started-business", "software-development", "gadget-business"] }
  ]
}
