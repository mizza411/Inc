{
  "version": 2,
  "app_name": "Inc Launcher",
  "settings": {
    "single_instance": true,
    "icon_path": "inc_launcher/assets/icon.png",
    "youtube_ops_active": true
  },
  "pillars": [
    {
      "id": "established",
      "label": "My Established business ideas",
      "items": [
        {
          "label": "Started Businesses folder",
          "action": "folder",
          "path": "Started-Businesses"
        },
        {
          "label": "Strategy 1 folder (playbook + gadget ops)",
          "action": "folder",
          "path": "Strategy-1-Business-Variation"
        },
        {
          "label": "Gadget business automation",
          "action": "folder",
          "path": "Strategy-1-Business-Variation/gadget-business/gadget-business-automation"
        },
        {
          "id": "youtube_status",
          "label": "YouTube automation (status)",
          "action": "command",
          "command": "python main.py status",
          "cwd": "Strategy-2-Problem-Solving/Content-Automation/youtube"
        }
      ]
    },
    {
      "id": "leads",
      "label": "My leads",
      "items": [
        {
          "label": "Abuja lead generator folder",
          "action": "folder",
          "path": "abuja_lead_generator"
        },
        {
          "label": "Lead generator README",
          "action": "file",
          "path": "abuja_lead_generator/README.md"
        },
        {
          "label": "Business development plan",
          "action": "file",
          "path": "abuja_lead_generator/business_development_plan.md"
        }
      ]
    },
    {
      "id": "formulated",
      "label": "Formulated ideas",
      "items": [
        {
          "id": "agent_formulation_run",
          "label": "Agent formulation run",
          "action": "agent_run",
          "pinned": true
        },
        {
          "id": "agent_formulation_pack",
          "label": "Agent formulation pack (Pass 2)",
          "action": "agent_run",
          "prompt_path": "prompts/agent_formulation_pack.txt",
          "modal_title": "Ready for Pass 2 pack?",
          "modal_bullets": [
            "Opens Cursor at the Inc repo",
            "Pastes pack prompt into chat (~8s)",
            "Same dated .md \u2192 uniform cards \u2192 Docx once"
          ]
        },
        {
          "label": "Run all strategies (CLI menu)",
          "action": "command",
          "command": "python run_all_strategies.py",
          "cwd": "."
        },
        {
          "id": "strategy1_run",
          "label": "Run Strategy 1 \u2014 Business Variation",
          "action": "command",
          "command": "python business_variation_collector.py",
          "cwd": "Strategy-1-Business-Variation"
        },
        {
          "id": "bookmark_review",
          "label": "Bookmark review",
          "action": "command",
          "command": "python -m business_bookmark_sorter review",
          "cwd": "."
        },
        {
          "label": "Agent run outputs folder",
          "action": "folder",
          "path": "agent-business-idea-runs/outputs"
        },
        {
          "id": "prospect_businesses_folder",
          "label": "Prospect Businesses folder",
          "action": "folder",
          "path": "Prospect-Businesses"
        },
        {
          "label": "Latest business ideas (Jul 2026)",
          "action": "file",
          "path": "agent-business-idea-runs/outputs/business_ideas_20260706.md"
        },
        {
          "label": "Business ideas (May 2026)",
          "action": "file",
          "path": "agent-business-idea-runs/outputs/business_ideas_20260508.md"
        },
        {
          "label": "Past business ideas",
          "action": "file",
          "path": "past_business_ideas.md"
        },
        {
          "label": "Business research folder",
          "action": "folder",
          "path": "business_research"
        },
        {
          "label": "Strategy 5 \u2014 News extraction",
          "action": "folder",
          "path": "Business-Idea-Formulation-Strategy-5-News-Based-Problem-Extraction"
        },
        {
          "label": "Strategy 15 \u2014 Nigeria open data",
          "action": "folder",
          "path": "Business-Idea-Formulation-Strategy-15-Nigeria-National-Open-Data"
        }
      ]
    },
    {
      "id": "problem_identification",
      "label": "Problem identification",
      "items": [
        {
          "label": "Problem ID tool (local web)",
          "action": "file",
          "path": "problem_identification_tool/web/index.html",
          "pinned": true
        },
        {
          "id": "problem_id_live",
          "label": "Problem ID tool \u2014 live site",
          "action": "url",
          "url": "https://mizza411.github.io/Inc/problem_identification_tool/web/index.html"
        },
        {
          "label": "Problem ID dashboard",
          "action": "file",
          "path": "problem_identification_tool/web/dashboard.html"
        },
        {
          "label": "Problem finder folder",
          "action": "folder",
          "path": "Strategy-2-Problem-Solving/problem_finder"
        },
        {
          "label": "Strategy 3 \u2014 Network problems",
          "action": "folder",
          "path": "Business-Idea-Formulation-Strategy-3-Network-Based-Problem-Identification"
        },
        {
          "id": "network_ask_remind",
          "label": "Ask people / owners (S3+S4)",
          "action": "network_ask",
          "pinned": true
        },
        {
          "label": "Strategy 12 \u2014 High-value filtering",
          "action": "folder",
          "path": "Business-Idea-Formulation-Strategy-12-High-Value-Problem-Filtering"
        }
      ]
    },
    {
      "id": "automation",
      "label": "Automation hub",
      "items": [
        {
          "label": "Content Automation folder",
          "action": "folder",
          "path": "Strategy-2-Problem-Solving/Content-Automation"
        },
        {
          "label": "YouTube automation",
          "action": "folder",
          "path": "Strategy-2-Problem-Solving/Content-Automation/youtube"
        },
        {
          "label": "YouTube CLI (help)",
          "action": "command",
          "command": "python main.py --help",
          "cwd": "Strategy-2-Problem-Solving/Content-Automation/youtube"
        },
        {
          "label": "Inc Launcher folder",
          "action": "folder",
          "path": "inc_launcher"
        }
      ]
    }
  ],
  "global_actions": [
    {
      "label": "Open Inc workspace",
      "action": "folder",
      "path": "."
    },
    {
      "id": "open_task_md",
      "label": "Open task.md",
      "action": "file",
      "path": ".cursor/rules/task.md"
    },
    {
      "label": "Open in Cursor",
      "action": "cursor"
    }
  ],
  "schedules": {
    "enabled": true,
    "items": [
      {
        "id": "daily_task_md",
        "time": "09:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ],
        "target": "open_task_md"
      },
      {
        "id": "daily_inc_hub",
        "time": "09:15",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ],
        "target": "hub"
      },
      {
        "id": "problem_id_live_mwf",
        "time": "10:00",
        "days": [
          "mon",
          "wed",
          "fri"
        ],
        "target": "problem_id_live"
      },
      {
        "id": "network_ask_mwf",
        "time": "09:30",
        "days": [
          "mon",
          "wed",
          "fri"
        ],
        "target": "network_ask_remind"
      },
      {
        "id": "bookmark_review_weekdays",
        "time": "11:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri"
        ],
        "target": "bookmark_review"
      },
      {
        "id": "youtube_status_sunday",
        "time": "18:00",
        "days": [
          "sun"
        ],
        "target": "youtube_status",
        "skip_when": {
          "setting": "youtube_ops_active",
          "equals": false
        }
      }
    ]
  }
}
