# Post-Wedding Comms Pack — environment (copy to .env)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional diaspora email
SENDGRID_API_KEY=
SENDER_EMAIL=

# Paystack P1 — set PAYMENTS_DISABLED=1 to skip paywall in dev
PAYMENTS_DISABLED=1
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_AMOUNT_KOBO=2500000
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=http://localhost:8501

# Webhook server (python webhook_server.py)
WEBHOOK_PORT=5001
WEBHOOK_BASIC_USER=
WEBHOOK_BASIC_PASSWORD=
PAYSTACK_WEBHOOK_STRICT=

# Optional override for verified payment store
# PAYMENT_STORE_PATH=
