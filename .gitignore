# Project-specific (Problem Identification Tool)
problem_identification_tool/qr_codes/
problem_identification_tool/generated_content/
qr_codes/
generated_content/

# Do not commit data (responses, analytics, exports)
problem_identification_tool/data/**
!problem_identification_tool/data/README.md

# Do not commit real configs; commit only example templates
problem_identification_tool/config/*.json
!problem_identification_tool/config/*.example.json

# Local environment files
problem_identification_tool/.env
*.env
problem_identification_tool/problem_identification_export_*.json
problem_identification_tool/problem_identification_export_*.csv
problem_identification_tool/data/*.csv
# Keep seed JSONs tracked; ignore only large or temp files
# If you prefer to ignore all data, uncomment next line:
# problem_identification_tool/data/

# Logs
*.log 

# Business bookmark sorter — local/personal data (never commit)
business_bookmark_sorter/data/**
!business_bookmark_sorter/data/.gitignore
!business_bookmark_sorter/data/README.md
business_bookmark_sorter/Business Links.md
business_bookmark_sorter/Business Links.docx
business_bookmark_sorter/~$*
business_bookmark_sorter/*.docx